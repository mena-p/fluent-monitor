# Copy to .env and fill in.  Keep .env private (it holds your password): chmod 600 .env
# Use single quotes around values containing $ or # or spaces.

# Folder with the report files at the first start, as reached from inside the university network.
# Afterwards you switch folders in the web page ("Change folder…"); that choice survives restarts.
# Changing this line later makes it win again once, at the next start.
# Windows: in cmd, `net use` shows the \\server\share behind a drive letter.
# Z:\Semesterarbeit\Fluent on \\fs01.uni.example\home$\pedro  ->
FLUENT_FOLDER='smb://fs01.uni.example/home$/pedro/Semesterarbeit/Fluent'

# The web page can browse and switch to any folder below this one.
# Empty = the whole share (smb://server/share). Narrow it down if the share holds more than your cases:
FM_ROOT=
# FM_ROOT='smb://fs01.uni.example/home$/pedro/Semesterarbeit'

# University account for that share (domain optional; "DOMAIN\user" or "user@uni.example" also work)
SMB_USERNAME=pedro
SMB_PASSWORD='change-me'
SMB_DOMAIN=

# Address you open on the phone (only used for the link printed in the log)
FM_PUBLIC_URL=http://tower:8050
# Port on the Unraid server
FM_PORT=8050
# Seconds between reads of the report files
FM_INTERVAL=2
TZ=Europe/Berlin
